# Copy this file to .env.local and fill in the values (.env.local is never committed).
# Without these, the demo still runs with scripted AI and in-memory data.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# MongoDB Atlas connection string (Database → Connect → Drivers), e.g.
# mongodb+srv://lingualink:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite   (translating chat; also the backup when GEMINI_MODEL is busy)
# MONGODB_DB=lingualink
# AI_DAILY_CAP=1500
